DISCORD_TOKEN=your_discord_bot_token_here
CLAUDE_CODE_OAUTH_TOKEN=your_claude_oauth_token_here

# Optional. Absolute path to a codebase the bot may read (Grep / Glob / Read).
# Leave empty to run text-only with no file access.
T5_PATH=C:Users\AbloPippi\Documents\Code\T5

# Optional. Set both to enable Azure DevOps access via the official
# @azure-devops/mcp server. Scope the PAT to what you actually want the bot
# to do (e.g. Work Items: Read, Code: Read for read-only access).
# ADO_ORG=contoso
# ADO_PAT=your_azure_devops_pat_here
# ADO_EMAIL=c-bot   # optional; any non-empty string works
